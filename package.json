{
  "name": "@voqalize/client-transport",
  "version": "0.1.0",
  "description": "An open implementation of pipecat's MediaManager protocol for SmallWebRTCTransport. Owns the microphone, camera and screen share in the browser using navigator.mediaDevices alone.",
  "keywords": [
    "pipecat",
    "webrtc",
    "voice-ai",
    "mediamanager",
    "getusermedia",
    "screenshare",
    "smallwebrtctransport"
  ],
  "license": "MIT",
  "author": "Voqalize",
  "homepage": "https://github.com/voqalize/voqalize-client-transport#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voqalize/voqalize-client-transport.git"
  },
  "bugs": {
    "url": "https://github.com/voqalize/voqalize-client-transport/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "vite",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "report": "playwright show-report",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@pipecat-ai/client-js": ">=1.13.0 <2",
    "@pipecat-ai/small-webrtc-transport": ">=1.10.0 <2"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@pipecat-ai/client-js": "^1.13.0",
    "@pipecat-ai/small-webrtc-transport": "^1.10.6",
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.4.1",
    "eslint": "^9.38.0",
    "prettier": "^3.6.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
